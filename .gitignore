# =============================================================================
# .gitignore for the Linux Skills Agent repository
# =============================================================================

# --- Runtime artefacts (large binaries / downloaded files) ---
runtime/vendor/
runtime/models/
runtime/llama-server
runtime/logs/

# --- Local configuration overrides (may contain API keys) ---
runtime/config.yaml
runtime/config.local.yaml

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/

# --- OS artefacts ---
.DS_Store
Thumbs.db
